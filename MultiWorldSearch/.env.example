# MWS environment variables
# Copy to .env and fill in values. .env is gitignored.

# --- Cloud mode ---
# "mock" (default): fully offline, deterministic, no API keys needed.
# "live": uses Gemini for embedding (teacher) and LLM (agent).
MWS_CLOUD_MODE=mock

# --- Google / Gemini ---
# Required only when MWS_CLOUD_MODE=live.
GOOGLE_API_KEY=

# Live mode models (defaults, configured in code):
#   Embedding: gemini-embedding-2 (768d via MRL, configurable to 1536/3072)
#   LLM:       gemini-3.5-flash

# --- Experiment settings ---
MWS_SEED=0
MWS_RUN_DIR=./runs
MWS_DATA_DIR=./data

# --- Embedding ---
# Default embedding dimensions (mock mode). Gemini teacher uses 768 via MRL.
MWS_EMBEDDING_DIMS=128
# Embedding space tag (mock-128-v1 | mock-768-v1 | gemma-128-v1 | gemini2-768-v1 | …)
MWS_DEFAULT_EMBEDDING_SPACE=mock-128-v1
