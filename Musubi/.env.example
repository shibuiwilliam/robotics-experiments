# Musubi environment — copy to .env (NEVER commit .env). Offline build needs none of these.
#
# Required only for live Gemini calls (make test-live / MUSUBI_VCR_MODE=record|passthrough).
# Offline build+test uses FakeGeminiClient + committed cassettes and needs no key.

# Google / Gemini API key (used only inside clients/ when recording live cassettes).
GOOGLE_API_KEY=

# VCR mode: replay (default, offline) | record (live, saves cassettes) | passthrough (live, no save).
# Overrides config/registry.yaml:vcr.default_mode. Leave unset for offline work.
# MUSUBI_VCR_MODE=replay
