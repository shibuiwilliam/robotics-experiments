<!--
  S3 Lab Custody scene for PSL-Bench.
  Panda arm (liquid handler) + transport cart (slide joints) + plate rack + 3 sample tubes.
  Frame convention: z-up, SI units (metres, radians, kg).
-->
<mujoco model="s3_lab_custody">
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <compiler angle="radian"/>

  <default>
    <joint damping="1.0" armature="0.1"/>
    <geom condim="4" friction="1 0.5 0.01"/>
  </default>

  <worldbody>
    <!-- Ground plane -->
    <geom name="floor" type="plane" size="3 3 0.1" rgba="0.8 0.8 0.8 1"/>

    <!-- Lab bench -->
    <body name="lab_bench" pos="0.5 0 0.4">
      <geom name="bench_top" type="box" size="0.5 0.4 0.02" rgba="0.85 0.85 0.9 1" mass="15"/>
    </body>

    <!-- Panda arm base (liquid handler) -->
    <body name="panda_link0" pos="0 0 0.42">
      <geom name="link0_geom" type="cylinder" size="0.06 0.05" rgba="0.9 0.9 0.9 1" mass="2.0"/>
      <body name="panda_link1" pos="0 0 0.05">
        <joint name="joint_0" type="hinge" axis="0 0 1" range="-2.8973 2.8973" damping="10"/>
        <geom name="link1_geom" type="capsule" fromto="0 0 0 0 0 0.333" size="0.04" rgba="0.9 0.9 0.9 1" mass="2.0"/>
        <body name="panda_link2" pos="0 0 0.333">
          <joint name="joint_1" type="hinge" axis="0 1 0" range="-1.7628 1.7628" damping="10"/>
          <geom name="link2_geom" type="capsule" fromto="0 0 0 0 0 0.316" size="0.04" rgba="0.9 0.9 0.9 1" mass="2.0"/>
          <body name="panda_link3" pos="0 0 0.316">
            <joint name="joint_2" type="hinge" axis="0 0 1" range="-2.8973 2.8973" damping="10"/>
            <geom name="link3_geom" type="capsule" fromto="0 0 0 0.0825 0 0" size="0.04" rgba="0.9 0.9 0.9 1" mass="2.0"/>
            <body name="panda_link4" pos="0.0825 0 0">
              <joint name="joint_3" type="hinge" axis="0 -1 0" range="-3.0718 -0.0698" damping="10"/>
              <geom name="link4_geom" type="capsule" fromto="0 0 0 -0.0825 0 0.384" size="0.04" rgba="0.9 0.9 0.9 1" mass="2.0"/>
              <body name="panda_link5" pos="-0.0825 0 0.384">
                <joint name="joint_4" type="hinge" axis="0 0 1" range="-2.8973 2.8973" damping="10"/>
                <geom name="link5_geom" type="sphere" size="0.04" rgba="0.9 0.9 0.9 1" mass="1.0"/>
                <body name="panda_link6" pos="0 0 0.088">
                  <joint name="joint_5" type="hinge" axis="0 1 0" range="-0.0175 3.7525" damping="5"/>
                  <geom name="link6_geom" type="capsule" fromto="0 0 0 0.088 0 0" size="0.03" rgba="0.9 0.9 0.9 1" mass="1.0"/>
                  <body name="panda_link7" pos="0.088 0 0">
                    <joint name="joint_6" type="hinge" axis="0 0 1" range="-2.8973 2.8973" damping="2"/>
                    <geom name="link7_geom" type="cylinder" size="0.04 0.02" rgba="0.3 0.3 0.3 1" mass="0.5"/>
                    <site name="ee_site" pos="0 0 0.107" size="0.01" rgba="1 0 0 1"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Transport cart (slide joints on floor) -->
    <body name="cart_base_x" pos="1.5 0 0.05">
      <geom type="sphere" size="0.001" mass="1" rgba="0 0 0 0"/>
      <joint name="cart_slide_x" type="slide" axis="1 0 0" range="-3 3" damping="30"/>
      <body name="cart_base_y">
        <geom type="sphere" size="0.001" mass="1" rgba="0 0 0 0"/>
      <joint name="cart_slide_y" type="slide" axis="0 1 0" range="-3 3" damping="30"/>
        <geom name="cart_platform" type="box" size="0.2 0.15 0.02" rgba="0.6 0.6 0.7 1" mass="5.0"/>
        <geom name="cart_wheel_fl" type="cylinder" pos="0.15 0.12 -0.03" euler="1.5708 0 0" size="0.025 0.015" rgba="0.2 0.2 0.2 1" mass="0.2"/>
        <geom name="cart_wheel_fr" type="cylinder" pos="0.15 -0.12 -0.03" euler="1.5708 0 0" size="0.025 0.015" rgba="0.2 0.2 0.2 1" mass="0.2"/>
        <geom name="cart_wheel_rl" type="cylinder" pos="-0.15 0.12 -0.03" euler="1.5708 0 0" size="0.025 0.015" rgba="0.2 0.2 0.2 1" mass="0.2"/>
        <geom name="cart_wheel_rr" type="cylinder" pos="-0.15 -0.12 -0.03" euler="1.5708 0 0" size="0.025 0.015" rgba="0.2 0.2 0.2 1" mass="0.2"/>
        <site name="cart_center" pos="0 0 0.02" size="0.02" rgba="0 1 0 1"/>
      </body>
    </body>

    <!-- Plate rack -->
    <body name="plate_rack" pos="0.7 -0.3 0.42">
      <geom name="rack_base" type="box" size="0.12 0.08 0.005" rgba="0.7 0.7 0.7 1" mass="1.0"/>
      <geom name="rack_slot_1" type="box" pos="-0.08 0 0.03" size="0.003 0.08 0.03" rgba="0.6 0.6 0.6 1" mass="0.1"/>
      <geom name="rack_slot_2" type="box" pos="0 0 0.03" size="0.003 0.08 0.03" rgba="0.6 0.6 0.6 1" mass="0.1"/>
      <geom name="rack_slot_3" type="box" pos="0.08 0 0.03" size="0.003 0.08 0.03" rgba="0.6 0.6 0.6 1" mass="0.1"/>
    </body>

    <!-- Sample tube 1 (red cap) -->
    <body name="sample_tube_1" pos="0.5 0.1 0.46">
      <freejoint name="tube1_free"/>
      <geom name="tube1_body" type="cylinder" size="0.008 0.04" rgba="0.9 0.9 0.95 1" mass="0.02"/>
      <geom name="tube1_cap" type="cylinder" pos="0 0 0.042" size="0.009 0.005" rgba="0.9 0.2 0.2 1" mass="0.005"/>
    </body>

    <!-- Sample tube 2 (green cap) -->
    <body name="sample_tube_2" pos="0.5 0.15 0.46">
      <freejoint name="tube2_free"/>
      <geom name="tube2_body" type="cylinder" size="0.008 0.04" rgba="0.9 0.9 0.95 1" mass="0.02"/>
      <geom name="tube2_cap" type="cylinder" pos="0 0 0.042" size="0.009 0.005" rgba="0.2 0.9 0.2 1" mass="0.005"/>
    </body>

    <!-- Sample tube 3 (blue cap) -->
    <body name="sample_tube_3" pos="0.5 0.2 0.46">
      <freejoint name="tube3_free"/>
      <geom name="tube3_body" type="cylinder" size="0.008 0.04" rgba="0.9 0.9 0.95 1" mass="0.02"/>
      <geom name="tube3_cap" type="cylinder" pos="0 0 0.042" size="0.009 0.005" rgba="0.2 0.2 0.9 1" mass="0.005"/>
    </body>
  </worldbody>

  <actuator>
    <!-- Panda arm actuators -->
    <position name="act_joint_0" joint="joint_0" kp="1000"/>
    <position name="act_joint_1" joint="joint_1" kp="1000"/>
    <position name="act_joint_2" joint="joint_2" kp="1000"/>
    <position name="act_joint_3" joint="joint_3" kp="1000"/>
    <position name="act_joint_4" joint="joint_4" kp="1000"/>
    <position name="act_joint_5" joint="joint_5" kp="1000"/>
    <position name="act_joint_6" joint="joint_6" kp="1000"/>
    <!-- Cart actuators -->
    <position name="act_cart_x" joint="cart_slide_x" kp="300"/>
    <position name="act_cart_y" joint="cart_slide_y" kp="300"/>
  </actuator>

  <sensor>
    <!-- Panda arm sensors -->
    <jointpos name="jpos_0" joint="joint_0"/>
    <jointpos name="jpos_1" joint="joint_1"/>
    <jointpos name="jpos_2" joint="joint_2"/>
    <jointpos name="jpos_3" joint="joint_3"/>
    <jointpos name="jpos_4" joint="joint_4"/>
    <jointpos name="jpos_5" joint="joint_5"/>
    <jointpos name="jpos_6" joint="joint_6"/>
    <jointvel name="jvel_0" joint="joint_0"/>
    <jointvel name="jvel_1" joint="joint_1"/>
    <jointvel name="jvel_2" joint="joint_2"/>
    <jointvel name="jvel_3" joint="joint_3"/>
    <jointvel name="jvel_4" joint="joint_4"/>
    <jointvel name="jvel_5" joint="joint_5"/>
    <jointvel name="jvel_6" joint="joint_6"/>
    <framepos name="ee_pos" objtype="site" objname="ee_site"/>
    <framequat name="ee_quat" objtype="site" objname="ee_site"/>
    <!-- Cart sensors -->
    <jointpos name="cart_x" joint="cart_slide_x"/>
    <jointpos name="cart_y" joint="cart_slide_y"/>
  </sensor>
</mujoco>
