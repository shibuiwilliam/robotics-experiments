# ---- ポート（他プロセスと衝突するときだけ上書きする）------------------------
# 既定は設計どおり 5432 / 9092・9644 / 7878 / 9000 / 8000。同じ開発機で他プロジェクトが
# これらを使っている場合（典型的には Postgres の 5432、S3 互換の 9000）はここで退避させる。
# 退避しても SBP 内部の参照は下の接続文字列を直せば一貫する。
# make は .env を --env-file で compose に渡す（X-14。docker compose を直接叩くときは自分で付ける）。
# SBP_PORT_POSTGRES=15432
# SBP_PORT_KAFKA=9092
# SBP_PORT_REDPANDA_ADMIN=9644
# SBP_PORT_OXIGRAPH=7878
# SBP_PORT_S3=19000
# SBP_PORT_CONSOLE=18080
# SBP_PORT_UI=5173
# observability profile のみ（make up PROFILES=observability）
# SBP_PORT_PROMETHEUS=9090
# SBP_PORT_GRAFANA=3000

# ---- Runtime ----------------------------------------------------------------
SBP_ENV=dev                          # dev | test | prod（dev 以外では開発用の要求者を作れない）
SBP_SITE_ID=siteA
SBP_PLATFORM=linux/arm64             # Intel Mac は linux/amd64
SBP_LOG_LEVEL=INFO

# ---- Event log (Redpanda, Kafka API) ---------------------------------------
SBP_KAFKA_BOOTSTRAP=localhost:9092
SBP_CONSUMER_GROUP_PREFIX=sbp

# ---- Postgres (TimescaleDB + pgvector) ------------------------------------
SBP_PG_DSN=postgresql://sbp:sbp@localhost:5432/sbp
# compose が Postgres を作るときの利用者・パスワード・DB 名（変えたら上の DSN も合わせる）
# SBP_PG_USER=sbp
# SBP_PG_PASSWORD=sbp
# SBP_PG_DB=sbp

# ---- Knowledge graph (Oxigraph) -------------------------------------------
SBP_SPARQL_QUERY_URL=http://localhost:7878/query
SBP_SPARQL_UPDATE_URL=http://localhost:7878/update
SBP_SPARQL_STORE_URL=http://localhost:7878/store

# ---- Object store (SeaweedFS, S3 API — ADR-0003) ---------------------------
SBP_S3_ENDPOINT=http://localhost:9000
SBP_S3_ACCESS_KEY=sbp
SBP_S3_SECRET_KEY=sbp-secret-change-me
SBP_S3_BUCKET_RAW=raw
SBP_S3_BUCKET_MODELS=models

# ---- ML ---------------------------------------------------------------------
PYTORCH_ENABLE_MPS_FALLBACK=1
SBP_WM_TORCH_DEVICE=mps              # mps | cpu

# ---- LLM --------------------------------------------------------------------
SBP_LLM_MODE=replay                  # replay | record | live
SBP_LLM_DEFAULT=anthropic            # anthropic | openai | gemini
SBP_EMBEDDINGS=openai                # openai | gemini | local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# SBP_ANTHROPIC_MAX_TOKENS=4096     # 応答の最大トークン。止まったら失敗（切れた出力は採らない）
OPENAI_API_KEY=
OPENAI_MODEL=                        # プロバイダの現行モデル ID を設定
GEMINI_API_KEY=
GEMINI_MODEL=                        # プロバイダの現行モデル ID を設定

# ---- Write-back -------------------------------------------------------------
SBP_WRITEBACK_MODE=dry               # dry | live

# ---- 接地ワーカーの配線（ADR-0009。既定値を置いていないので bridge-worker を動かすなら必須）----
# 走らせるプローブの IRI（版を含む）。カンマ区切り。置き場 (S3) にこの版の束ねが要る
# SBP_BRIDGE_PROBE_IDS=https://sbp.example/probe/Running/1.0.0
# 読む潜在を作った WM 版の IRI。プローブ側と一致しなければ起動時に落ちる
# SBP_BRIDGE_WM_VERSION=https://sbp.example/wm/koopman/0.1.0

# ---- 層別の閾値（既定値は sbp.core.config の Settings にある。上書きするときだけ設定する）----
# この節も .env から効く（X-11。以前は環境変数からしか読まれなかった）。
# 接地層（設計書 §5.2, §5.3, §5.7）
# SBP_BRIDGE_PROMOTE_MIN_AUROC=0.85
# SBP_BRIDGE_PROMOTE_MAX_ECE=0.05
# SBP_BRIDGE_HYSTERESIS_HIGH=0.7
# SBP_BRIDGE_HYSTERESIS_LOW=0.3
# SBP_BRIDGE_MIN_DURATION_S=20
# SBP_BRIDGE_WEAK_EVIDENCE_THRESHOLD=0.3
# SBP_BRIDGE_ALIGNMENT_RESIDUAL_WARN=0.2
# SBP_BRIDGE_IDENTITY_REVOKE_THRESHOLD=0.5
# SBP_BRIDGE_PROBE_TRAIN_FRACTION=0.6
# SBP_BRIDGE_PROBE_CALIB_FRACTION=0.2
# SBP_BRIDGE_PROBE_MIN_LABELLED=20
# SBP_BRIDGE_WEAK_LABEL_MIN_HALF_WIDTH_S=300
# 推論層（設計書 §8.1, §8.2）
# SBP_REASONING_THETA_EXISTENCE=0.8
# SBP_REASONING_THETA_STATE_JS=0.5
# SBP_REASONING_THETA_NORM=0.7
# SBP_REASONING_TIME_TOLERANCE_PERCENTILE=0.95
# SBP_REASONING_PERSISTENCE_S=300
# SBP_REASONING_SEVERITY_VALUE_SCALE=1000000
# SBP_REASONING_SEVERITY_PERSISTENCE_SCALE_S=3600
# SBP_REASONING_MAX_HUMAN_QUERIES_PER_HOUR=4
# 周期と窓（照合の窓は 刻み × 刻み数 が持続 τ を覆わないと構築時に落ちる）
# SBP_REASONING_BP_PERIOD_S=60
# SBP_REASONING_BP_MAX_ITERATIONS=5
# SBP_REASONING_FILTER_STEP_S=10
# SBP_REASONING_RECONCILE_PERIOD_S=120
# SBP_REASONING_WINDOW_SAMPLES=360
# SBP_REASONING_SCHEDULER_MAX_QUERIES=10
# SBP_REASONING_SCHEDULER_TOTAL_COST=1.0
# SBP_REASONING_BATCH_SIZE=100
# 期限切れの期待を検証する周期（learning-worker。ADR-0017）
# SBP_REASONING_EXPECTATION_VERIFY_PERIOD_S=60
# 予測（make forecast。ADR-0032）
# SBP_REASONING_FORECAST_HORIZON_STEPS=30  # 予測の地平（WM の刻み数。make forecast、ADR-0032）
# SBP_REASONING_FORECAST_STRIDE=5           # 採点する先行時間の間隔（刻み数）
# SBP_REASONING_FORECAST_SAMPLES=30         # ロールアウトの本数
# SBP_REASONING_FORECAST_INTERVAL_LEVEL=0.9 # 予測区間の名目被覆
# SBP_REASONING_FORECAST_STATE_STD=0.05     # 起点の潜在の不確実性（各次元の標準偏差）
# SBP_REASONING_FORECAST_PERIOD_S=300       # 予測を出す周期（秒）
# SBP_REASONING_FORECAST_GRACE_S=60         # 地平の終端から採点するまでの猶予（秒）
# SBP_REASONING_FORECAST_MAX_ORIGIN_AGE_S=3600  # 起点の潜在の古さの上限（秒）
# SBP_REASONING_FORECAST_COMPLETE_WAIT_S=86400  # 全先行時間の信念を待つ上限（秒）
# 概念発見（learning-worker。ADR-0019）。周期・却下の冷却日数・1 周期の提案数の上限・反復とみなす回数
# SBP_REASONING_DISCOVERY_PERIOD_S=86400
# SBP_REASONING_DISCOVERY_REJECTION_COOLDOWN_DAYS=30
# SBP_REASONING_DISCOVERY_MAX_PROPOSALS_PER_CYCLE=3
# SBP_REASONING_DISCOVERY_MIN_REPEATS=3
# 人の確認回答が信念に入るときの確信度と時刻の不確実幅（ADR-0018）
# SBP_REASONING_HUMAN_ANSWER_CONFIDENCE=0.98
# SBP_REASONING_HUMAN_ANSWER_UNCERTAINTY_S=300
# 不一致の起票先（ADR-0010）。site | central。両方には出さない（event_id が 2 つになる）
# SBP_REASONING_DISCREPANCY_SCOPE=site
# WM 層（設計書 §4.8）
# SBP_WM_LATENT_SHIFT_WARN=0.1
# SBP_WM_PRED_ERROR_WARN=0.3
# SBP_WM_ENSEMBLE_SIZE=3
# SBP_WM_ROLLOUT_SAMPLES=32
# 観測窓のスプール（JSONL）の置き場。エッジが置き、エンコードジョブが読む（ADR-0023）。既定値なし
# SBP_WM_SPOOL_DIR=data/spool

# 業務統合の取込ワーカー（ADR-0016。SBP_INTEGRATION_*）
# 業務システムを読みに行く周期（秒）。資産台帳もこの周期で全行を同期する
# SBP_INTEGRATION_POLL_PERIOD_S=60
# 開発用の業務システムモック（SQLite のファイル）。空なら ingest-worker はコネクタ無しで起動する
# SBP_INTEGRATION_MOCK_DB_PATH=data/mock-business.sqlite

# アクション層（期待の生成。SBP_ACTIONS_*）
# 業務効果の期待の下端。契約が threshold を宣言していないときに使う。
# 記録の存在に対する信念は情報源の信頼性で割り引かれるので 1.0 にしない（必ず違反になる）。
# 実データで較正していない暫定値である。
SBP_ACTIONS_RECORD_EFFECT_FLOOR=0.5
