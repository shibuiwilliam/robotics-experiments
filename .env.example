# ---- ポート（他プロセスと衝突するときだけ上書きする）------------------------
# 既定は設計どおり 5432 / 9092 / 7878 / 9000・9001 / 8000。同じ開発機で他プロジェクトが
# これらを使っている場合（典型的には Postgres の 5432、S3 互換の 9000）はここで退避させる。
# 退避しても SBP 内部の参照は下の接続文字列を直せば一貫する。
# SBP_PORT_POSTGRES=15432
# SBP_PORT_KAFKA=9092
# SBP_PORT_OXIGRAPH=7878
# SBP_PORT_S3=19000
# SBP_PORT_CONSOLE=18080
# SBP_PORT_UI=5173

# ---- Runtime ----------------------------------------------------------------
SBP_ENV=dev                          # dev | test
SBP_SITE_ID=siteA
SBP_PLATFORM=linux/arm64             # Intel Mac は linux/amd64
SBP_LOG_LEVEL=INFO

# ---- Event log (Redpanda, Kafka API) ---------------------------------------
SBP_KAFKA_BOOTSTRAP=localhost:9092
SBP_CONSUMER_GROUP_PREFIX=sbp

# ---- Postgres (TimescaleDB + pgvector) ------------------------------------
SBP_PG_DSN=postgresql://sbp:sbp@localhost:5432/sbp

# ---- Knowledge graph (Oxigraph) -------------------------------------------
SBP_SPARQL_QUERY_URL=http://localhost:7878/query
SBP_SPARQL_UPDATE_URL=http://localhost:7878/update
SBP_SPARQL_STORE_URL=http://localhost:7878/store

# ---- Object store (SeaweedFS, S3 API — ADR-0003) ---------------------------
SBP_S3_ENDPOINT=http://localhost:9000
SBP_S3_ACCESS_KEY=sbp
SBP_S3_SECRET_KEY=sbp-secret-change-me
SBP_S3_BUCKET_RAW=raw
SBP_S3_BUCKET_MODELS=models

# ---- ML ---------------------------------------------------------------------
PYTORCH_ENABLE_MPS_FALLBACK=1
SBP_WM_TORCH_DEVICE=mps              # mps | cpu

# ---- LLM --------------------------------------------------------------------
SBP_LLM_MODE=replay                  # replay | record | live
SBP_LLM_DEFAULT=anthropic            # anthropic | openai | gemini
SBP_EMBEDDINGS=openai                # openai | gemini | local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=                        # プロバイダの現行モデル ID を設定
GEMINI_API_KEY=
GEMINI_MODEL=                        # プロバイダの現行モデル ID を設定

# ---- Write-back -------------------------------------------------------------
SBP_WRITEBACK_MODE=dry               # dry | live

# ---- 接地ワーカーの配線（ADR-0009。既定値を置いていないので bridge-worker を動かすなら必須）----
# 走らせるプローブの IRI（版を含む）。カンマ区切り。置き場 (S3) にこの版の束ねが要る
# SBP_BRIDGE_PROBE_IDS=https://sbp.example/probe/Running/1.0.0
# 読む潜在を作った WM 版の IRI。プローブ側と一致しなければ起動時に落ちる
# SBP_BRIDGE_WM_VERSION=https://sbp.example/wm/koopman/0.1.0

# ---- 層別の閾値（既定値は sbp.core.config の Settings にある。上書きするときだけ設定する）----
# 接地層（設計書 §5.2, §5.3, §5.7）
# SBP_BRIDGE_PROMOTE_MIN_AUROC=0.85
# SBP_BRIDGE_PROMOTE_MAX_ECE=0.05
# SBP_BRIDGE_HYSTERESIS_HIGH=0.7
# SBP_BRIDGE_HYSTERESIS_LOW=0.3
# SBP_BRIDGE_MIN_DURATION_S=20
# SBP_BRIDGE_IDENTITY_REVOKE_THRESHOLD=0.5
# 推論層（設計書 §8.1, §8.2）
# SBP_REASONING_THETA_EXISTENCE=0.8
# SBP_REASONING_THETA_STATE_JS=0.5
# SBP_REASONING_THETA_NORM=0.7
# SBP_REASONING_PERSISTENCE_S=300
# SBP_REASONING_MAX_HUMAN_QUERIES_PER_HOUR=4
# 不一致の起票先（ADR-0010）。site | central。両方には出さない（event_id が 2 つになる）
# SBP_REASONING_DISCREPANCY_SCOPE=site
# WM 層（設計書 §4.8）
# SBP_WM_ENSEMBLE_SIZE=3
# SBP_WM_ROLLOUT_SAMPLES=32
