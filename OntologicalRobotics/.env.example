# ORX environment variables
# Copy to .env and fill in values. .env is gitignored — never commit secrets.
# (CLAUDE.md §1: APIキーは環境変数からのみ読む。コード・コンフィグに書かない)
#
# 既定の動作は完全オフライン（stubプロバイダ）で、環境変数は一切不要。
# 以下が必要になるのは live 計測（provider.mode=openai）のときだけ。

# --- OpenAI（LLM・テキスト埋め込み） ---
# T2エージェント条件 / T7 vector-rag / T5 LLM支援マッピングの live 計測に必要。
# 注意: live 実行前に概算トークンの承認を得ること（CLAUDE.md §6, ~0.9-1.5Mトークン）。
OPENAI_API_KEY=

# 使用するモデル（モデルIDは https://developers.openai.com/api/docs/models）。
# 解決順序: 実験コンフィグの明示値 > これらの環境変数 > コードの既定値。
# experiment YAML の provider.llm_model を省略すると ここの値が使われる。
# 注: make 経由なら .env は自動で子プロセスへ渡る。直接 `uv run` する場合は
#     `set -a; source .env; set +a` 等で export してから実行する。
ORX_LLM_MODEL=gpt-5.4-mini
ORX_TEXT_EMBEDDING_MODEL=text-embedding-3-small

# --- Hugging Face（任意） ---
# ローカルCLIP（open_clip ViT-B-32）の初回ダウンロードのレート制限緩和用。
# 未設定でも動く（匿名ダウンロード）。テスト・デモはCLIP不要（stub埋め込み）。
HF_TOKEN=
