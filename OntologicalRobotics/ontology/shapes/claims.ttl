# SHACL shapes v0 — 世界グラフ書込の品質制約 (PROJECT.md §5.2)
# 1) 全クレームに来歴・確信度・時刻を強制 (不変条件2)
# 2) owl:sameAs の直書きを禁止 (不変条件3 — orx-upper:anchoredTo を使う)

@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix orx-prov: <https://orx.local/onto/prov#> .
@prefix orx-sh: <https://orx.local/onto/shapes#> .

orx-sh:ClaimShape a sh:NodeShape ;
    sh:targetClass orx-prov:Claim ;
    sh:property [
        sh:path orx-prov:assertedBy ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "クレームに来歴 (assertedBy) がありません"@ja ;
    ] ;
    sh:property [
        sh:path orx-prov:confidence ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ;
        sh:message "クレームに確信度 [0,1] がありません"@ja ;
    ] ;
    sh:property [
        sh:path orx-prov:observedAt ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "クレームに観測時刻がありません"@ja ;
    ] ;
    sh:property [
        sh:path orx-prov:validUntil ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
    ] .

orx-sh:NoSameAsShape a sh:NodeShape ;
    sh:targetSubjectsOf owl:sameAs ;
    sh:property [
        sh:path owl:sameAs ;
        sh:maxCount 0 ;
        sh:message "owl:sameAs の直書きは禁止。orx-upper:anchoredTo (確信度付き) を使うこと"@ja ;
    ] .
