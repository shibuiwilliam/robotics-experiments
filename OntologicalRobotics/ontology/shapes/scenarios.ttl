# SHACL shapes — シナリオ語彙のクラス固有制約（IMPROVEMENT.md H-1）
# 汎用 ClaimShape（claims.ttl）が来歴・確信度・時刻を担保するのに加え、ここでは
# シナリオ新語彙の構造制約を定義する。全書込パスは tests/scenarios/*/test_shapes_*.py で検証。

@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix orx-biz: <https://orx.local/onto/biz#> .
@prefix orx-sh:  <https://orx.local/onto/shapes#> .

# --- S1 ロット回収（T8） ---

orx-sh:RecallOrderShape a sh:NodeShape ;
    sh:targetClass orx-biz:RecallOrder ;
    sh:property [
        sh:path orx-biz:targetsLot ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "RecallOrder は targetsLot をちょうど1つ持たねばならない"@ja ;
    ] .

orx-sh:MemberOfLotShape a sh:NodeShape ;
    sh:targetSubjectsOf orx-biz:memberOfLot ;
    sh:property [
        sh:path orx-biz:memberOfLot ;
        sh:class orx-biz:Lot ;
        sh:minCount 1 ;
        sh:message "memberOfLot の値は orx-biz:Lot 型でなければならない（識別子スレッドの整合）"@ja ;
    ] .

# --- S2 アレルゲン交差汚染（T9） ---
@prefix orx-st: <https://orx.local/onto/st#> .

orx-sh:ContactEventShape a sh:NodeShape ;
    sh:targetClass orx-st:ContactEvent ;
    sh:property [
        sh:path orx-st:contactParty ;
        sh:minCount 2 ;
        sh:nodeKind sh:IRI ;
        sh:message "ContactEvent は contactParty を2つ以上持つ（両当事者）"@ja ;
    ] .

orx-sh:PossiblyContaminatedShape a sh:NodeShape ;
    sh:targetSubjectsOf orx-st:possiblyContaminatedBy ;
    sh:property [
        sh:path orx-st:possiblyContaminatedBy ;
        sh:class orx-biz:AllergenClass ;
        sh:minCount 1 ;
        sh:message "possiblyContaminatedBy の値は AllergenClass でなければならない"@ja ;
    ] .

# --- S6 リサイクル選別（T13） ---
orx-sh:RegulatedClassShape a sh:NodeShape ;
    sh:targetClass orx-biz:RegulatedClass ;
    sh:property [
        sh:path orx-biz:disposalRoute ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "RegulatedClass は disposalRoute をちょうど1つ持つ（規制規則の一意性）"@ja ;
    ] .

# --- S3 多ベンダー製造ライン（T10） ---
@prefix orx-cap: <https://orx.local/onto/cap#> .

orx-sh:ProcessRequirementShape a sh:NodeShape ;
    sh:targetClass orx-cap:ProcessRequirement ;
    sh:property [
        sh:path orx-cap:requiresPayloadKg ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "ProcessRequirement は requiresPayloadKg をちょうど1つ持つ（工程の重量要件）"@ja ;
    ] ;
    sh:property [
        sh:path orx-cap:requiresMaterial ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "ProcessRequirement は requiresMaterial をちょうど1つ持つ（把持面素材）"@ja ;
    ] .

# --- S7 介護施設「所有」（T14） ---
orx-sh:ResidentShape a sh:NodeShape ;
    sh:targetClass orx-biz:Resident ;
    sh:property [
        sh:path orx-biz:assignedRoom ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Resident は assignedRoom をちょうど1つ持つ（配送先の一意性）"@ja ;
    ] .

orx-sh:OwnsShape a sh:NodeShape ;
    sh:targetSubjectsOf orx-biz:owns ;
    sh:property [
        sh:path orx-biz:owns ;
        sh:class orx-biz:PersonalItem ;
        sh:minCount 1 ;
        sh:message "owns の値は PersonalItem 型でなければならない（所有関係の整合）"@ja ;
    ] .

# --- S4 プラント点検（T11） ---
orx-sh:AssetShape a sh:NodeShape ;
    sh:targetClass orx-biz:Asset ;
    sh:property [
        sh:path orx-biz:inSystem ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Asset は inSystem をちょうど1つ持つ（系統トポロジ＝SOP引当キー）"@ja ;
    ] .

orx-sh:WorkOrderShape a sh:NodeShape ;
    sh:targetClass orx-biz:WorkOrder ;
    sh:property [
        sh:path orx-biz:forAsset ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "WorkOrder は forAsset をちょうど1つ持つ（対象資産の一意性）"@ja ;
    ] ;
    sh:property [
        sh:path orx-biz:appliesSop ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "WorkOrder は appliesSop をちょうど1つ持つ（適用SOP）"@ja ;
    ] .

# --- S5 病院内搬送（T12, 規範層） ---
@prefix orx-norm: <https://orx.local/onto/norm#> .

orx-sh:ProhibitionShape a sh:NodeShape ;
    sh:targetClass orx-norm:Prohibition ;
    sh:property [
        sh:path orx-norm:appliesToItemClass ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Prohibition は appliesToItemClass をちょうど1つ持つ（適用物分類）"@ja ;
    ] ;
    sh:property [
        sh:path orx-norm:forbidsZoneClass ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Prohibition は forbidsZoneClass をちょうど1つ持つ（禁止区画分類）"@ja ;
    ] .

orx-sh:CustodyStepShape a sh:NodeShape ;
    sh:targetClass orx-norm:CustodyStep ;
    sh:property [
        sh:path orx-norm:custodyOf ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "CustodyStep は custodyOf をちょうど1つ持つ（搬送物の一意性）"@ja ;
    ] ;
    sh:property [
        sh:path orx-norm:atZone ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "CustodyStep は atZone をちょうど1つ持つ（通行区画）"@ja ;
    ] .
