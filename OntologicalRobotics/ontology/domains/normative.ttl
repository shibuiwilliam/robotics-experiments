# ORX 規範ドメインオントロジー v0（S5 / T12 で新設）
# 出典: deontic logic（義務/禁止/許可）と SOMA/規制オントロジーの規範概念を剪定・簡約。
# 規範は「適用条件（物分類×区画分類×時間帯×機体認証状態）」付きの義務/禁止/許可主張。
# 計画時に違反経路を事前棄却し、custody連鎖（来歴）で監査可能性を担保する。

@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix orx-upper: <https://orx.local/onto/upper#> .
@prefix orx-norm: <https://orx.local/onto/norm#> .

orx-norm: a owl:Ontology ;
    rdfs:comment "規範: 義務・禁止・許可と適用条件（deontic）。計画時規範チェックと監査の基盤"@ja .

orx-norm:Norm a owl:Class ;
    rdfs:subClassOf orx-upper:InformationEntity ;
    rdfs:label "規範"@ja ;
    rdfs:comment "適用条件付きの義務/禁止/許可主張"@ja .

orx-norm:Prohibition a owl:Class ;
    rdfs:subClassOf orx-norm:Norm ;
    rdfs:label "禁止"@ja ;
    rdfs:comment "ある物分類がある区画分類を通過してはならない等"@ja .

orx-norm:Obligation a owl:Class ;
    rdfs:subClassOf orx-norm:Norm ;
    rdfs:label "義務"@ja .

orx-norm:Permission a owl:Class ;
    rdfs:subClassOf orx-norm:Norm ;
    rdfs:label "許可"@ja .

orx-norm:appliesToItemClass a owl:DatatypeProperty ;
    rdfs:domain orx-norm:Norm ; rdfs:range xsd:string ;
    rdfs:label "適用物分類"@ja ;
    rdfs:comment "規範が適用される物の分類（controlled_drug 等）"@ja .

orx-norm:forbidsZoneClass a owl:DatatypeProperty ;
    rdfs:domain orx-norm:Prohibition ; rdfs:range xsd:string ;
    rdfs:label "禁止区画分類"@ja ;
    rdfs:comment "この物分類が通過してはならない区画分類（public 等）"@ja .

# --- custody 連鎖（監査可能性） ---
orx-norm:CustodyStep a owl:Class ;
    rdfs:subClassOf orx-upper:Event ;
    rdfs:label "custody通行ステップ"@ja ;
    rdfs:comment "搬送の1通行（来歴・確信度・時刻付き）。監査クエリで連鎖を再構成する"@ja .

orx-norm:custodyOf a owl:ObjectProperty ;
    rdfs:domain orx-norm:CustodyStep ; rdfs:range orx-upper:PhysicalObject ;
    rdfs:label "custody対象搬送物"@ja .

orx-norm:atZone a owl:DatatypeProperty ;
    rdfs:domain orx-norm:CustodyStep ; rdfs:range xsd:string ;
    rdfs:label "通行区画"@ja .

orx-norm:stepIndex a owl:DatatypeProperty ;
    rdfs:domain orx-norm:CustodyStep ; rdfs:range xsd:integer ;
    rdfs:label "通行順序"@ja .
