# ORX 業務・文書ドメインオントロジー v0
# 受注・SKU・出荷指示・SOP文書。すべて情報的実体（物理的実体とのカテゴリ混同を防ぐ）。
# アイデンティティ・スレッド: Order → ShippingInstruction → barcode(リテラル) →
# 物理個体の orx-upper:hasIdentifier と同値結合で橋渡しする。

@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix orx-upper: <https://orx.local/onto/upper#> .
@prefix orx-biz: <https://orx.local/onto/biz#> .

orx-biz: a owl:Ontology ;
    rdfs:comment "業務・文書: WMSレコードとSOP文書の語彙"@ja .

orx-biz:Order a owl:Class ;
    rdfs:subClassOf orx-upper:InformationEntity ;
    rdfs:label "受注"@ja .

orx-biz:Sku a owl:Class ;
    rdfs:subClassOf orx-upper:InformationEntity ;
    rdfs:label "SKU"@ja .

orx-biz:ShippingInstruction a owl:Class ;
    rdfs:subClassOf orx-upper:InformationEntity ;
    rdfs:label "出荷指示"@ja .

orx-biz:Document a owl:Class ;
    rdfs:subClassOf orx-upper:InformationEntity ;
    rdfs:label "文書（SOP等）"@ja .

orx-biz:ordersSku a owl:ObjectProperty ;
    rdfs:domain orx-biz:Order ; rdfs:range orx-biz:Sku .

orx-biz:forOrder a owl:ObjectProperty ;
    rdfs:domain orx-biz:ShippingInstruction ; rdfs:range orx-biz:Order .

orx-biz:hasBarcode a owl:DatatypeProperty ;
    rdfs:domain orx-biz:ShippingInstruction ; rdfs:range xsd:string ;
    rdfs:comment "物理個体の orx-upper:hasIdentifier と結合する識別子の糸"@ja .

orx-biz:status a owl:DatatypeProperty ;
    rdfs:domain orx-biz:Order ; rdfs:range xsd:string .

orx-biz:destination a owl:DatatypeProperty ;
    rdfs:domain orx-biz:Order ; rdfs:range xsd:string .

orx-biz:quantity a owl:DatatypeProperty ;
    rdfs:domain orx-biz:Order ; rdfs:range xsd:integer .

orx-biz:skuName a owl:DatatypeProperty ;
    rdfs:domain orx-biz:Sku ; rdfs:range xsd:string .

orx-biz:weightKg a owl:DatatypeProperty ;
    rdfs:domain orx-biz:Sku ; rdfs:range xsd:double .

orx-biz:fragile a owl:DatatypeProperty ;
    rdfs:domain orx-biz:Sku ; rdfs:range xsd:boolean .

orx-biz:appliesTo a owl:ObjectProperty ;
    rdfs:domain orx-biz:Document ;
    rdfs:comment "SOP文書が適用される対象クラス/SKU（T7 オントロジー誘導検索）"@ja .

orx-biz:situation a owl:DatatypeProperty ;
    rdfs:domain orx-biz:Document ; rdfs:range xsd:string ;
    rdfs:comment "手順書の適用状況タグ (handling / damage / storage)"@ja .

orx-biz:docTitle a owl:DatatypeProperty ;
    rdfs:domain orx-biz:Document ; rdfs:range xsd:string .

# --- S1 ロット回収（T8） ---
orx-biz:Lot a owl:Class ;
    rdfs:subClassOf orx-upper:InformationEntity ;
    rdfs:label "ロット"@ja ;
    rdfs:comment "製造/入荷ロット。個装(barcode)の集合。回収の単位"@ja .

orx-biz:memberOfLot a owl:ObjectProperty ;
    rdfs:range orx-biz:Lot ;
    rdfs:label "ロット帰属"@ja ;
    rdfs:comment "個装(ShippingInstruction/物理個体)→ロット。回収対象の逆引き経路"@ja .

orx-biz:RecallOrder a owl:Class ;
    rdfs:subClassOf orx-upper:InformationEntity ;
    rdfs:label "回収指示"@ja .

orx-biz:targetsLot a owl:ObjectProperty ;
    rdfs:domain orx-biz:RecallOrder ; rdfs:range orx-biz:Lot ;
    rdfs:label "回収対象ロット"@ja .

# --- S2 アレルゲンクラス（T9） ---
orx-biz:AllergenClass a owl:Class ;
    rdfs:subClassOf orx-upper:InformationEntity ;
    rdfs:label "アレルゲンクラス"@ja ;
    rdfs:comment "peanut/gluten 等の規制対象アレルゲン区分"@ja .

# --- S6 リサイクル選別：規制オントロジー（T13） ---
orx-biz:RegulatedClass a owl:Class ;
    rdfs:subClassOf orx-upper:InformationEntity ;
    rdfs:label "規制対象クラス"@ja ;
    rdfs:comment "battery/freon 等。処理経路が法規制で定まる製品クラス"@ja .

orx-biz:disposalRoute a owl:ObjectProperty ;
    rdfs:domain orx-biz:RegulatedClass ;
    rdfs:label "規定処理経路"@ja ;
    rdfs:comment "規制クラス → 処理レーン（規制規則・記号側の知識）"@ja .

orx-biz:routedTo a owl:ObjectProperty ;
    rdfs:domain orx-upper:PhysicalObject ;
    rdfs:label "割当レーン"@ja .

# --- S7 介護施設「所有」（T14, H2/H4/H6） ---
orx-biz:Resident a owl:Class ;
    rdfs:subClassOf orx-upper:Agent ;
    rdfs:label "入居者"@ja .

orx-biz:PersonalItem a owl:Class ;
    rdfs:subClassOf orx-upper:PhysicalObject ;
    rdfs:label "個人持ち物"@ja ;
    rdfs:comment "入居者が所有する小物。所有は観測不可能な情報的関係"@ja .

orx-biz:owns a owl:ObjectProperty ;
    rdfs:domain orx-biz:Resident ; rdfs:range orx-biz:PersonalItem ;
    rdfs:label "所有"@ja ;
    rdfs:comment "知覚不可能な情報的関係。台帳でのみ確定する（H6）"@ja .

orx-biz:assignedRoom a owl:DatatypeProperty ;
    rdfs:domain orx-biz:Resident ; rdfs:range xsd:string ;
    rdfs:label "居室"@ja ;
    rdfs:comment "配送先（業務-物理クエリの解）"@ja .

# --- S4 プラント点検（T11, H2/H5） ---
orx-biz:Asset a owl:Class ;
    rdfs:subClassOf orx-upper:PhysicalObject ;
    rdfs:label "資産台帳個体（P&ID）"@ja ;
    rdfs:comment "資産台帳・P&ID上の設備個体。知覚個体と ID無しでアンカリングする"@ja .

orx-biz:inSystem a owl:DatatypeProperty ;
    rdfs:domain orx-biz:Asset ; rdfs:range xsd:string ;
    rdfs:label "所属系統"@ja ;
    rdfs:comment "系統トポロジ（SOP引当のキー）"@ja .

orx-biz:WorkOrder a owl:Class ;
    rdfs:subClassOf orx-upper:InformationEntity ;
    rdfs:label "作業指示"@ja .

orx-biz:forAsset a owl:ObjectProperty ;
    rdfs:domain orx-biz:WorkOrder ; rdfs:range orx-biz:Asset ;
    rdfs:label "対象資産"@ja .

orx-biz:appliesSop a owl:DatatypeProperty ;
    rdfs:domain orx-biz:WorkOrder ; rdfs:range xsd:string ;
    rdfs:label "適用SOP"@ja ;
    rdfs:comment "異常→該当系統SOP→作業指示の連鎖の結果"@ja .
